#!/bin/bash
set -e

# Get iteration count from parameter or prompt user
if [ -z "$1" ]; then
    read -p "Enter number of iterations: " iterations
    if ! [[ "$iterations" =~ ^[0-9]+$ ]] || [ "$iterations" -lt 1 ]; then
        echo "Error: Invalid iteration count. Must be a positive number."
        exit 1
    fi
else
    iterations="$1"
fi

# Get PRD name from parameter or prompt user
if [ -n "$2" ]; then
    prd_name="$2"
    prd_file="prd_todo/${prd_name}.md"
    if [ ! -f "$prd_file" ]; then
        echo "Error: PRD file not found: $prd_file"
        echo ""
        echo "Available PRDs in prd_todo/:"
        ls -1 prd_todo/*.md 2>/dev/null | sed 's|prd_todo/||;s|\.md$||' | nl -w2 -s'. ' || echo "  (none)"
        exit 1
    fi
else
    # List available PRDs in prd_todo folder
    prd_files=($(ls -1 prd_todo/*.md 2>/dev/null | sort))

    if [ ${#prd_files[@]} -eq 0 ]; then
        echo "Error: No PRD files found in prd_todo/"
        exit 1
    fi

    # If only one PRD, use it automatically
    if [ ${#prd_files[@]} -eq 1 ]; then
        selected_prd="${prd_files[0]}"
        prd_name=$(basename "$selected_prd" .md)
        prd_file="prd_todo/${prd_name}.md"
    else
        # Multiple PRDs - ask user to select
        echo "Available PRDs:"
        for i in "${!prd_files[@]}"; do
            prd_name=$(basename "${prd_files[$i]}" .md)
            echo "  $((i+1)). $prd_name"
        done
        echo ""
        read -p "Select PRD number (1-${#prd_files[@]}): " selection

        # Validate selection
        if ! [[ "$selection" =~ ^[0-9]+$ ]] || [ "$selection" -lt 1 ] || [ "$selection" -gt ${#prd_files[@]} ]; then
            echo "Error: Invalid selection"
            exit 1
        fi

        # Get selected PRD
        selected_prd="${prd_files[$((selection-1))]}"
        prd_name=$(basename "$selected_prd" .md)
        prd_file="prd_todo/${prd_name}.md"
    fi
fi

progress_file="prd_todo/${prd_name}_progress.txt"

# Create progress file if it doesn't exist
touch "$progress_file"

echo ""
echo "Working on: $prd_name"
echo "PRD: $prd_file"
echo "Progress: $progress_file"
echo ""

for ((i=1; i<=$iterations; i++)); do
    echo "--- Iteration $i of $iterations ---"
    echo ""
    echo "Running claude command..."
    echo ""

    # Use a temporary file to capture output while also displaying it in real-time
    temp_output=$(mktemp)

    # Force unbuffered output for Python programs and use stdbuf for line buffering
    # PYTHONUNBUFFERED=1 ensures Python programs output immediately
    # stdbuf -oL -eL forces line buffering for stdout and stderr
    # tee displays output in real-time while also capturing it
    export PYTHONUNBUFFERED=1
    if command -v stdbuf >/dev/null 2>&1; then
        stdbuf -oL -eL env PYTHONUNBUFFERED=1 claude --permission-mode acceptEdits -p "@${prd_file} @${progress_file} \\
1. Find the highest-priority task and implement it. \\
2. Run your tests and type checks. \\
3. Update the PRD with what was done. \\
4. Append your progress to ${progress_file}. \\
5. Commit your changes using non-interactive git commands (use --no-verify flag if needed, never use interactive prompts). \\
ONLY WORK ON A SINGLE TASK. \\
Use only non-interactive commands - never prompt for user input. \\
If the PRD is complete, output <promise>COMPLETE</promise>." 2>&1 | stdbuf -oL -eL tee "$temp_output"
    else
        # Fallback: try unbuffer from expect package, or just use PYTHONUNBUFFERED
        if command -v unbuffer >/dev/null 2>&1; then
            unbuffer env PYTHONUNBUFFERED=1 claude --permission-mode acceptEdits -p "@${prd_file} @${progress_file} \\
1. Find the highest-priority task and implement it. \\
2. Run your tests and type checks. \\
3. Update the PRD with what was done. \\
4. Append your progress to ${progress_file}. \\
5. Commit your changes using non-interactive git commands (use --no-verify flag if needed, never use interactive prompts). \\
ONLY WORK ON A SINGLE TASK. \\
Use only non-interactive commands - never prompt for user input. \\
If the PRD is complete, output <promise>COMPLETE</promise>." 2>&1 | tee "$temp_output"
        else
            env PYTHONUNBUFFERED=1 claude --permission-mode acceptEdits -p "@${prd_file} @${progress_file} \\
1. Find the highest-priority task and implement it. \\
2. Run your tests and type checks. \\
3. Update the PRD with what was done. \\
4. Append your progress to ${progress_file}. \\
5. Commit your changes using non-interactive git commands (use --no-verify flag if needed, never use interactive prompts). \\
ONLY WORK ON A SINGLE TASK. \\
Use only non-interactive commands - never prompt for user input. \\
If the PRD is complete, output <promise>COMPLETE</promise>." 2>&1 | tee "$temp_output"
        fi
    fi

    echo ""
    echo "Claude command completed. Checking result..."

    result=$(cat "$temp_output")
    rm "$temp_output"

    if [[ "$result" == *"<promise>COMPLETE</promise>"* ]]; then
        echo ""
        echo "PRD complete after $i iterations."
        echo ""
        echo "Moving PRD to prd_done..."
        mkdir -p prd_done
        mv "$prd_file" "prd_done/${prd_name}.md"
        mv "$progress_file" "prd_done/${prd_name}_progress.txt"
        echo "Moved $prd_name to prd_done/"
        exit 0
    fi
done
